#!/bin/sh /etc/rc.common

USE_PROCD=1
START=95
STOP=10

CONFIG_FILE="/etc/wifi-analyzer/openwrt-agent.json"
AGENT_FILE="/usr/lib/wifi-analyzer/openwrt_agent.py"

start_service() {
    if [ ! -r "$CONFIG_FILE" ]; then
        echo "WiFi Analyzer agent: configuration is missing or unreadable" >&2
        return 1
    fi
    if [ ! -r "$AGENT_FILE" ]; then
        echo "WiFi Analyzer agent: agent program is missing" >&2
        return 1
    fi

    procd_open_instance
    procd_set_param command /usr/bin/python3 "$AGENT_FILE" run --config "$CONFIG_FILE"
    procd_set_param respawn 3600 5 5
    procd_set_param stdout 1
    procd_set_param stderr 1
    procd_close_instance
}
