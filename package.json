{
  "name": "wifi-analyzer-pro",
  "version": "1.0.7",
  "description": "Cross-platform Wi-Fi discovery, RF analysis and network diagnostics",
  "author": "NetCore Technologies",
  "license": "MIT",
  "homepage": "https://github.com/NetCore-Technologies/wifi-analyzer-pro",
  "repository": {
    "type": "git",
    "url": "https://github.com/NetCore-Technologies/wifi-analyzer-pro.git"
  },
  "keywords": [
    "wifi",
    "wireless",
    "network",
    "analyzer",
    "diagnostics",
    "raspberry-pi",
    "openwrt",
    "rf"
  ],
  "private": false,
  "type": "module",
  "scripts": {
    "dev": "vite --port 5173",
    "build": "vite build",
    "preview": "vite preview --port 4173",
    "lint": "eslint src --ext .js,.jsx",
    "test:frontend": "node --test src/lib/*.test.js",
    "format": "prettier --write src/**/*.{js,jsx,css}",
    "test": "python -m unittest discover -s tests -v",
    "test:backend": "python -m unittest discover -s tests -v",
    "check:python": "python -m compileall -q wifi_analyzer_backend tests"
  },
  "dependencies": {
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "recharts": "^3.10.1",
    "framer-motion": "^14.14.0",
    "lucide-react": "^1.73.0",
    "react-router-dom": "^7.18.5",
    "axios": "^1.7.2",
    "date-fns": "^4.4.0",
    "clsx": "^2.1.1"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "autoprefixer": "^10.7.0",
    "eslint": "^10.15.0",
    "postcss": "^8.4.39",
    "prettier": "^3.3.2",
    "tailwindcss": "^4.3.5",
    "vite": "^8.3.5",
    "tailwindcss-animate": "^1.0.7"
  }
}
