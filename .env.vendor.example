WIFI_ANALYZER_VENDOR_LICENSE_SIGNING_PRIVATE_KEY_FILE=/secure/vendor-secrets/wifi-analyzer-license.key
WIFI_ANALYZER_VENDOR_STRIPE_SECRET_KEY=
WIFI_ANALYZER_VENDOR_STRIPE_WEBHOOK_SECRET=
WIFI_ANALYZER_VENDOR_STRIPE_PRICE_PRO=
WIFI_ANALYZER_VENDOR_STRIPE_PRICE_BUSINESS=
WIFI_ANALYZER_VENDOR_STRIPE_PRICE_ENTERPRISE=
