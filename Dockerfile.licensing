FROM python:3.12-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    HOME=/home/wifi-licensing

WORKDIR /app

RUN groupadd --system --gid 10001 wifi-licensing \
    && useradd --system --uid 10001 --gid wifi-licensing \
       --home-dir /home/wifi-licensing --create-home --shell /usr/sbin/nologin wifi-licensing

COPY wifi_analyzer_backend/requirements.txt ./requirements.txt
RUN python -m pip install --no-cache-dir -r requirements.txt

COPY --chown=10001:10001 wifi_analyzer_backend ./wifi_analyzer_backend

RUN mkdir -p /home/wifi-licensing/.local/state/vendor-license \
    && chown -R 10001:10001 /home/wifi-licensing

VOLUME ["/home/wifi-licensing/.local/state"]
USER 10001:10001

EXPOSE 1999
HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
    CMD python -c "import urllib.request; urllib.request.urlopen('http://127.0.0.1:1999/health', timeout=3)"

CMD ["python", "-m", "wifi_analyzer_backend.licensing_service"]
