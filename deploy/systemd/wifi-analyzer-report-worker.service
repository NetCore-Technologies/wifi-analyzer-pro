[Unit]
Description=WiFi Analyzer Pro scheduled report delivery worker
Documentation=https://github.com/NetCore-Technologies/wifi-analyzer-pro/blob/main/wifi_analyzer_backend/REPORT_WORKER.md
After=network-online.target wifi-analyzer-pro.service
Wants=network-online.target
Requires=wifi-analyzer-pro.service

[Service]
Type=simple
User=wifi-analyzer
Group=wifi-analyzer
WorkingDirectory=/opt/wifi-analyzer-pro/current
Environment=HOME=/var/lib/wifi-analyzer-pro
Environment=XDG_STATE_HOME=/var/lib
StateDirectory=wifi-analyzer-pro
StateDirectoryMode=0700
UMask=0077
EnvironmentFile=/etc/wifi-analyzer-pro/report-worker.env
ExecStart=/opt/wifi-analyzer-pro/venv/bin/python -m wifi_analyzer_backend.report_worker
Restart=on-failure
RestartSec=5s
TimeoutStopSec=30s
KillSignal=SIGTERM
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
LockPersonality=true
RestrictSUIDSGID=true
RestrictRealtime=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
CapabilityBoundingSet=
AmbientCapabilities=
ReadWritePaths=/var/lib/wifi-analyzer-pro

[Install]
WantedBy=multi-user.target
