[Unit]
Description=WiFi Analyzer Pro site-alert webhook notification bridge
Documentation=https://github.com/NetCore-Technologies/wifi-analyzer-pro/blob/main/wifi_analyzer_backend/ALERT_WEBHOOK_BRIDGE.md
After=wifi-analyzer-pro.service
Requires=wifi-analyzer-pro.service

[Service]
Type=simple
User=wifi-analyzer
Group=wifi-analyzer
WorkingDirectory=/opt/wifi-analyzer-pro/current
Environment=HOME=/var/lib/wifi-analyzer-pro
Environment=XDG_STATE_HOME=/var/lib
Environment=WIFI_ANALYZER_ALERT_WEBHOOK_POLL_SECONDS=5
Environment=WIFI_ANALYZER_ALERT_WEBHOOK_BATCH_SIZE=50
StateDirectory=wifi-analyzer-pro
StateDirectoryMode=0700
UMask=0077
LoadCredential=webhook-signing-keys:/etc/wifi-analyzer-pro/webhook-signing-keys.json
Environment=WIFI_ANALYZER_WEBHOOK_SIGNING_KEYS_FILE=%d/webhook-signing-keys
ExecStart=/opt/wifi-analyzer-pro/venv/bin/python -m wifi_analyzer_backend.alert_webhook_worker
Restart=on-failure
RestartSec=5s
TimeoutStopSec=30s
KillSignal=SIGTERM
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
LockPersonality=true
RestrictSUIDSGID=true
RestrictRealtime=true
RestrictAddressFamilies=AF_UNIX
CapabilityBoundingSet=
AmbientCapabilities=
ReadWritePaths=/var/lib/wifi-analyzer-pro

[Install]
WantedBy=multi-user.target
