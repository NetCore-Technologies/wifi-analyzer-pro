# WiFi Analyzer Pro Compose deployment
# Keep this file free of passwords and signing secrets.
# Loopback only by default. Use 0.0.0.0 only behind a firewall and trusted
# VPN/authenticated TLS reverse proxy.
WIFI_ANALYZER_BIND_ADDRESS=127.0.0.1
WIFI_ANALYZER_IMAGE=wifi-analyzer-pro:local
WIFI_ANALYZER_WEBHOOK_DELIVERY_RETENTION_DAYS=90

# Optional third-party feature plugins. Install signed packages in this directory.
# The trust store contains public Ed25519 publisher keys and is not a signing secret.
WIFI_ANALYZER_PLUGIN_TRUST_KEYS_FILE=

# Optional alert-to-webhook bridge. Store key material in a protected JSON file.
# The Compose bridge reads this file as a Docker secret; never put secrets here.
WIFI_ANALYZER_WEBHOOK_SIGNING_KEYS_FILE=
WIFI_ANALYZER_ALERT_WEBHOOK_POLL_SECONDS=5
WIFI_ANALYZER_ALERT_WEBHOOK_BATCH_SIZE=50

# Optional Home Assistant MQTT discovery; start with the home-assistant profile.
WIFI_ANALYZER_HA_MQTT_HOST=
WIFI_ANALYZER_HA_DEVICE_ID=
WIFI_ANALYZER_HA_MQTT_PORT=8883
WIFI_ANALYZER_HA_MQTT_USERNAME=
WIFI_ANALYZER_HA_MQTT_PASSWORD_FILE=
WIFI_ANALYZER_HA_MQTT_CA_CERT_FILE=
WIFI_ANALYZER_HA_MQTT_TLS=true
WIFI_ANALYZER_HA_MQTT_DISCOVERY_PREFIX=homeassistant
WIFI_ANALYZER_HA_MQTT_POLL_SECONDS=60

# Optional Prometheus scrape endpoint; disabled when the token is blank.
# Generate a private value with: openssl rand -hex 32
WIFI_ANALYZER_LOCAL_SITE_ID=local
WIFI_ANALYZER_PROMETHEUS_TOKEN=

# Optional Stripe subscription billing. Create recurring Prices in Stripe and
# map each server-side price ID to a plan. Never commit real secrets.
WIFI_ANALYZER_PUBLIC_URL=
WIFI_ANALYZER_STRIPE_SECRET_KEY=
WIFI_ANALYZER_STRIPE_WEBHOOK_SECRET=
WIFI_ANALYZER_STRIPE_PRICE_PRO=
WIFI_ANALYZER_STRIPE_PRICE_BUSINESS=
WIFI_ANALYZER_STRIPE_PRICE_ENTERPRISE=

# Vendor product licence verification only needs a public key on customer installs.
# Keep the matching Ed25519 private signing key on the vendor control plane.
WIFI_ANALYZER_VENDOR_LICENSE_PUBLIC_KEY=
WIFI_ANALYZER_VENDOR_LICENSE_KEY_ID=primary

# Optional customer-side vendor licence renewal schedule (defaults: 15m check / 12h window).
WIFI_ANALYZER_VENDOR_LICENSE_RENEW_INTERVAL_SECONDS=900
WIFI_ANALYZER_VENDOR_LICENSE_RENEW_WINDOW_SECONDS=43200
